ENV=local
GOOGLE_API_KEY="GOOGLE_API_KEY"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/milo
DB_POOL_SIZE="10"
DB_MAX_OVERFLOW="10"
FIREBASE_SERVICE_ACCOUNT_PATH="serviceaccountjsonpath"
AUTH_REQUIRED=true
VERTEX_PROJECT="your-gcp-project-id"
VERTEX_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
AUTO_EVALUATE_ON_CHAT_CLOSE=true
# Dev-only. When true, the engine builds a per-turn execution trace and the
# WebSocket emits a `policy_debug` frame for each turn (scores, stage
# transitions with reasons, rules fired/skipped, interceptor outcome).
# Pair with REACT_APP_POLICY_DEBUG=true in milo-gui to render the panel.
POLICY_DEBUG_ENABLED=false

# Email (Resend) — emails are silently skipped if RESEND_API_KEY is empty.
RESEND_API_KEY=""
EMAIL_FROM="Milo <onboarding@resend.dev>"
FRONTEND_BASE_URL="http://localhost:3000"
