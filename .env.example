ENV=local
GOOGLE_API_KEY="GOOGLE_API_KEY"
OPENAI_API_KEY=""
EDGE_TTS_VOICE_ES="es-US-PalomaNeural"
EDGE_TTS_VOICE_EN="en-US-AriaNeural"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/milo
DB_POOL_SIZE="10"
DB_MAX_OVERFLOW="10"
FIREBASE_SERVICE_ACCOUNT_PATH="serviceaccountjsonpath"
AUTH_REQUIRED=true
VERTEX_PROJECT="your-gcp-project-id"
VERTEX_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
AUTO_EVALUATE_ON_CHAT_CLOSE=true

# ── LLM model routing ──────────────────────────────────────────────────────
# Per-mode model selection. Voice favors latency (Flash); text favors depth
# (Pro). Both fall back to LLM_MODEL when unset, then to per-mode defaults.
LLM_MODEL_VOICE="gemini-2.5-flash"
LLM_MODEL_TEXT="gemini-2.5-pro"
# Output budget. Voice keeps replies short so the first TTS sentence lands
# quickly; text uses the full budget.
LLM_MAX_TOKENS_VOICE="512"
LLM_MAX_TOKENS_TEXT="8192"
# Legacy single-model override. If set, used as the fallback for both
# LLM_MODEL_VOICE and LLM_MODEL_TEXT when those are not explicitly defined.
# Leave empty to use the per-mode defaults above.
# LLM_MODEL=""

# ── Speech-to-text provider ────────────────────────────────────────────────
# "whisper" (OpenAI Whisper-1) or "gemini" (Gemini Flash audio input — same
# credit pool as the LLM, typically faster and cheaper for short utterances).
STT_PROVIDER="gemini"
# Model used when STT_PROVIDER=gemini.
STT_GEMINI_MODEL="gemini-2.5-flash"
# Dev-only. When true, the engine builds a per-turn execution trace and the
# WebSocket emits a `policy_debug` frame for each turn (scores, stage
# transitions with reasons, rules fired/skipped, interceptor outcome).
# Pair with REACT_APP_POLICY_DEBUG=true in milo-gui to render the panel.
POLICY_DEBUG_ENABLED=false

# Email (Resend) — emails are silently skipped if RESEND_API_KEY is empty.
RESEND_API_KEY=""
EMAIL_FROM="Milo <onboarding@resend.dev>"
FRONTEND_BASE_URL="http://localhost:3000"

# S3 — activity context files (teacher uploads). The orchestrator issues
# presigned PUT URLs scoped to S3_ACTIVITY_FILES_BUCKET; milo-ingest reacts
# to the resulting S3 events to embed/clean up RAG vectors.
AWS_REGION="us-east-1"
S3_ACTIVITY_FILES_BUCKET="milo-raw-ingest-local"
# Set AWS_ENDPOINT_URL for LocalStack/dev. Leave empty in prod.
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"