# Auto-HTTPS reverse proxy + static GUI host.
# {$DROPLET_IP} is injected from the environment (see docker-compose.yml).
# sslip.io maps <name>.<ip>.sslip.io -> <ip>, so Caddy gets real Let's Encrypt certs.

# Orchestrator API (Caddy proxies WebSocket upgrades transparently).
api.{$DROPLET_IP}.sslip.io {
    reverse_proxy orchestrator:8000
}

# Milo GUI — static CRA build mounted into the caddy container at /srv/gui.
# Served on the No-IP hostname plus the legacy sslip.io name (both get LE certs).
milo-tutor.ddns.net, app.{$DROPLET_IP}.sslip.io {
    root * /srv/gui
    encode gzip

    # VAD model/wasm (~15 MB) — cacheable but NOT immutable: the filenames
    # aren't content-hashed, and a vad-web/onnxruntime upgrade must not serve
    # stale wasm/mjs pairs. 1 day fresh + SWR; file_server's ETag makes
    # revalidations cheap 304s. No SPA fallback here: a missing asset must
    # 404, not return index.html (ORT fails cryptically on HTML-as-wasm).
    handle /vad/* {
        header Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
        file_server
    }

    # CRA bundles under /static/ are content-hashed → safe to cache forever.
    handle /static/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        try_files {path} /index.html   # SPA client-side routing fallback
        file_server
    }
}
