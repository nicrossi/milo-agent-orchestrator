# Copy to deploy/orchestrator.env on the Droplet and fill in. DO NOT COMMIT the real file.
# chmod 600 deploy/orchestrator.env after creating it.

# --- Database (AWS RDS Postgres + PGVector) ---
# asyncpg driver is applied automatically. Do NOT put ?sslmode=... here;
# set DB_SSL instead (the app translates it to an asyncpg SSL context).
DATABASE_URL=postgresql://USER:PASS@your-rds-endpoint.rds.amazonaws.com:5432/DBNAME
DB_SSL=require
# DB_SSL=verify-full         # stronger; requires DB_SSL_ROOT_CERT below
# DB_SSL_ROOT_CERT=/secrets/rds-ca.pem

# --- CORS: the GUI origin (App Platform domain, filled in after step 9) ---
ALLOWED_ORIGINS=https://milo-gui-xxxxx.ondigitalocean.app

# --- RAG ---
RAG_WORKERS=3

# --- Auth (Firebase) ---
AUTH_REQUIRED=true
FIREBASE_SERVICE_ACCOUNT_PATH=/secrets/firebase.json

# --- LLM / STT (Gemini) ---
GOOGLE_API_KEY=your-gemini-api-key
# Or use Vertex instead of an API key:
# VERTEX_PROJECT=your-gcp-project
# VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp.json
LLM_MODEL_TEXT=gemini-2.5-pro
LLM_MODEL_VOICE=gemini-2.5-flash
STT_PROVIDER=gemini

# --- AWS S3 (activity files) ---
S3_ACTIVITY_FILES_BUCKET=your-activity-files-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# --- Frontend URL (used in transactional email CTAs) ---
FRONTEND_BASE_URL=https://milo-gui-xxxxx.ondigitalocean.app

# --- Optional: email reminders (omit to skip sends) ---
# RESEND_API_KEY=your-resend-key
# EMAIL_FROM=Milo <onboarding@resend.dev>

# --- Optional ---
# POLICY_DEBUG_ENABLED=false
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
